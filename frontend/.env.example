# URL du backend Express
# Utilisée côté client si tu switches vers des appels directs.
# Actuellement l'app utilise les rewrites Next.js (cf. next.config.ts).
NEXT_PUBLIC_API_URL=http://localhost:5000

# URL du backend utilisée par les rewrites Next.js au moment du build.
# En local : http://localhost:5001
# Sur Vercel (frontend) : https://stock-manager-api.vercel.app (ton vrai domaine backend)
BACKEND_URL=http://localhost:5001

# Nom affiché de la plateforme (ex: "GStock", "Roi Soleil ERP")
# Valeur par défaut si absent : "GStock"
NEXT_PUBLIC_APP_NAME=Stock Manager
