# Chaîne de connexion à la base de données PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://admin:adminpassword@localhost:5433/gstock_db?schema=public

# Clé secrète utilisée pour signer les tokens JWT
# IMPORTANT : doit faire au moins 32 caractères aléatoires en production
# Générer avec : openssl rand -base64 48
JWT_SECRET=changeme_at_least_32_chars_long_secret

# URL du frontend autorisée par la politique CORS
# En développement local : http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Port sur lequel le serveur Express écoute
PORT=5000

# Environnement d'exécution : development | production
NODE_ENV=development
