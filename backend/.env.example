# Chaîne de connexion à la base de données PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# En local / Docker :
DATABASE_URL=postgresql://admin:adminpassword@localhost:5433/gstock_db?schema=public
# Avec Neon (Vercel) : coller la pooled connection string, ex:
# DATABASE_URL=postgresql://user:password@xxx-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require

# Force l'utilisation du driver Neon serverless (même avec une URL non-neon.tech).
# Utile pour tester en local le driver serverless, ou si Neon est derrière un proxy.
USE_NEON_DRIVER=false

# Clé secrète utilisée pour signer les tokens JWT
# IMPORTANT : doit faire au moins 32 caractères aléatoires en production
# Générer avec : openssl rand -base64 48
JWT_SECRET=changeme_at_least_32_chars_long_secret

# URL du frontend autorisée par la politique CORS
# En développement local : http://localhost:3000
# Sur Vercel : https://stock-manager-frontend.vercel.app (ton vrai domaine)
FRONTEND_URL=http://localhost:3000

# Port sur lequel le serveur Express écoute
# Ignoré sur Vercel (serverless), mais utile en local / Docker
PORT=5000

# Environnement d'exécution : development | production
NODE_ENV=development

# Fournisseur d'email pour le flux "mot de passe oublié" (envoi d'OTP).
# Valeurs : mailpit | resend | brevo
#   mailpit = SMTP local (développement) — rien d'autre à configurer
#   resend  = https://resend.com → renseigner RESEND_API_KEY
#   brevo   = https://brevo.com  → renseigner BREVO_API_KEY
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=
BREVO_API_KEY=
# Paramètres SMTP custom (utilisés si EMAIL_PROVIDER n'est ni resend ni brevo,
# et pour mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Confiance accordée au proxy inverse (nginx/traefik) pour lire X-Forwarded-For.
#   false    = pas de proxy (défaut sécurisé)
#   1        = derrière UN reverse proxy
#   loopback = ne faire confiance qu'aux connexions locales
# Requis pour que le rate limiting identifie correctement les IP clients.
TRUST_PROXY=false

# Autoriser la liste publique des magasins sur la page de login (mode démo).
# Désactivé par défaut (liste exposée via GET /api/auth/stores).
ALLOW_PUBLIC_STORE_LIST=false
