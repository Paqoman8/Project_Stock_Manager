{
  "name": "backend",
  "version": "1.0.0",
  "description": "Stock Manager API backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run build && mkdir -p public && echo '<html><body>Stock Manager API — see /api/health</body></html>' > public/index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "resend": "^6.18.0",
    "serverless-http": "^3.2.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.14",
    "prisma": "7.8.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
