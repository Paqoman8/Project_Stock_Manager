generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String            @unique
  email        String?           @unique
  pwd_hash     String
  role_id      String            @db.Uuid
  is_active    Boolean           @default(true)
  role         Role              @relation(fields: [role_id], references: [id])
  store_access UserStoreAccess[]
  sessions     SessionLog[]
  transactions Transaction[]
  acted_audits AuditLog[]

  @@map("users")
}

model Store {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  location         String?
  color            String            @default("#1D4ED8") @db.VarChar(7)
  type             StoreType         @default(MAGASIN)
  status           StoreStatus       @default(ACTIVE)
  closed_at        DateTime?
  phone            String?           @db.VarChar(20)
  description      String?
  is_protected     Boolean           @default(false)
  user_access      UserStoreAccess[]
  sessions         SessionLog[]
  inventories      Inventory[]
  transfers_from   Transfer[]        @relation("TransfersFrom")
  transfers_to     Transfer[]        @relation("TransfersTo")
  transactions     Transaction[]
  audit_logs       AuditLog[]        @relation("AuditStore")

  @@map("stores")
}

model UserStoreAccess {
  user_id  String @db.Uuid
  store_id String @db.Uuid
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store    Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@id([user_id, store_id])
  @@map("user_store_access")
}

model SessionLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String   @db.Uuid
  store_id String   @db.Uuid
  login_at DateTime @default(now())
  user     User     @relation(fields: [user_id], references: [id])
  store    Store    @relation(fields: [store_id], references: [id])

  @@map("sessions_log")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parent_id String?    @db.Uuid
  parent    Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}

model Product {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku               String            @unique
  name              String
  price             Decimal           @db.Decimal(10, 2)
  category_id       String            @db.Uuid
  category          Category          @relation(fields: [category_id], references: [id])
  inventories       Inventory[]
  transfer_items    TransferItem[]
  transaction_items TransactionItem[]

  @@map("products")
}

model Inventory {
  store_id       String  @db.Uuid
  product_id     String  @db.Uuid
  stock_physical Int     @default(0)
  stock_reserved Int     @default(0)
  store          Store   @relation(fields: [store_id], references: [id])
  product        Product @relation(fields: [product_id], references: [id])

  @@id([store_id, product_id])
  @@map("inventory")
}

enum TransferStatus {
  PENDING
  DONE
  CANCEL
}

model Transfer {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_store_id String         @db.Uuid
  to_store_id   String         @db.Uuid
  status        TransferStatus @default(PENDING)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  from_store    Store          @relation("TransfersFrom", fields: [from_store_id], references: [id])
  to_store      Store          @relation("TransfersTo", fields: [to_store_id], references: [id])
  items         TransferItem[]

  @@map("transfers")
}

model TransferItem {
  transfer_id String   @db.Uuid
  product_id  String   @db.Uuid
  qty         Int
  transfer    Transfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id])

  @@id([transfer_id, product_id])
  @@map("transfer_items")
}

enum TransactionType {
  SALE
  REFUND
  EXPENSE
}

model Transaction {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id     String            @db.Uuid
  user_id      String            @db.Uuid
  type         TransactionType
  total_amount Decimal           @db.Decimal(10, 2)
  created_at   DateTime          @default(now())
  store        Store             @relation(fields: [store_id], references: [id])
  user         User              @relation(fields: [user_id], references: [id])
  items        TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String      @db.Uuid
  product_id     String      @db.Uuid
  qty            Int
  price_at_sale  Decimal     @db.Decimal(10, 2)
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [product_id], references: [id])

  @@map("transaction_items")
}

// ---------------------------------------------------------------------------
// Types d'établissements
// ---------------------------------------------------------------------------

enum StoreType {
  MAGASIN
  BOUTIQUE
  ENTREPOT
}

enum StoreStatus {
  ACTIVE
  CLOSED
}

// ---------------------------------------------------------------------------
// Journal d'audit — trace toutes les actions métier de la plateforme
// ---------------------------------------------------------------------------

enum AuditAction {
  // Authentification
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT

  // Gestion des utilisateurs
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED

  // Gestion des établissements
  STORE_CREATED
  STORE_UPDATED
  STORE_CLOSED
  STORE_REOPENED
  STORE_DELETED

  // Gestion des fournisseurs
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_DEACTIVATED
  SUPPLIER_REACTIVATED
}

// ---------------------------------------------------------------------------
// Fournisseurs — conditions de paiement et référentiel fournisseurs
// ---------------------------------------------------------------------------

enum PaymentTerms {
  IMMEDIATE
  NET30
  NET60
  NET90
}

model Supplier {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  contact_name  String?
  email         String?      @unique
  phone         String?      @db.VarChar(20)
  address       String?
  payment_terms PaymentTerms @default(NET30)
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@map("suppliers")
}

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime    @default(now())

  // Qui — nullable pour les tentatives de connexion échouées (user inconnu)
  actor_id    String?     @db.Uuid
  actor_name  String      // Dénormalisé : nom au moment du fait

  // Quoi
  action      AuditAction

  // Sur quoi — nullable pour les actions sans cible (login/logout)
  target_type String?
  target_id   String?     @db.Uuid
  target_name String?     // Dénormalisé : nom au moment du fait

  // Contexte magasin — nullable (login échoué peut ne pas avoir de magasin)
  store_id    String?     @db.Uuid
  store_name  String?     // Dénormalisé

  // Adresse IP du poste depuis lequel l'action a été effectuée
  // VarChar(45) couvre IPv4 (15 cars) et IPv6 complet (39 cars)
  ip_address  String?     @db.VarChar(45)

  // Données contextuelles selon l'action : raison, modifications, détails…
  metadata    Json?       @db.JsonB

  actor       User?       @relation(fields: [actor_id], references: [id])
  store       Store?      @relation("AuditStore", fields: [store_id], references: [id])

  @@map("audit_logs")
}
