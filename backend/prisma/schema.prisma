// ---------------------------------------------------------------------------
// DATABASE CONFIGURATION                                                   
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTHENTICATION & AUTHORIZATION                                           
// ---------------------------------------------------------------------------

model Role {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String @unique
  users User[]

  @@map("roles")
}


model User {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String            @unique
  email          String?           @unique
  pwd_hash       String
  role_id        String            @db.Uuid
  is_active      Boolean           @default(true)
  role           Role              @relation(fields: [role_id], references: [id])
  store_access      UserStoreAccess[]
  sessions          SessionLog[]
  transactions      Transaction[]
  acted_audits      AuditLog[]
  purchase_orders   PurchaseOrder[]
  receptions        StockReception[]
  stock_movements   StockMovement[]   @relation("MovementsPerformedBy")
  created_reports   InventoryReport[] @relation("ReportsCreatedBy")
  validated_reports InventoryReport[] @relation("ReportsValidatedBy")

  @@map("users")
}


// ---------------------------------------------------------------------------
// STORES & ACCESS CONTROL                                                  
// ---------------------------------------------------------------------------

model Store {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  location         String?
  color            String            @default("#1D4ED8") @db.VarChar(7)
  type             StoreType         @default(MAGASIN)
  status           StoreStatus       @default(ACTIVE)
  closed_at        DateTime?
  phone            String?           @db.VarChar(20)
  description      String?
  is_protected     Boolean           @default(false)
  user_access        UserStoreAccess[]
  sessions           SessionLog[]
  inventories        Inventory[]
  transfers_from     Transfer[]        @relation("TransfersFrom")
  transfers_to       Transfer[]        @relation("TransfersTo")
  transactions       Transaction[]
  audit_logs         AuditLog[]        @relation("AuditStore")
  purchase_orders    PurchaseOrder[]   @relation("PurchaseOrderDestination")
  stock_movements      StockMovement[]
  inventory_reports    InventoryReport[]
  inventory_breakdowns InventoryBreakdown[]

  @@map("stores")
}


model UserStoreAccess {
  user_id  String @db.Uuid
  store_id String @db.Uuid
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  store    Store  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@id([user_id, store_id])
  @@map("user_store_access")
}


model SessionLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String   @db.Uuid
  store_id String   @db.Uuid
  login_at DateTime @default(now())
  user     User     @relation(fields: [user_id], references: [id])
  store    Store    @relation(fields: [store_id], references: [id])

  @@map("sessions_log")
}


// ---------------------------------------------------------------------------
// PRODUCT CATALOG & PACKAGING                                              
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parent_id String?    @db.Uuid
  parent    Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}


// Product units — base measurement for inventory and sales
enum ProductUnit {
  PIECE
  KG
  G
  L
  CL
  ML
  BOUTEILLE
  SACHET
  BOITE
}


model Product {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku               String            @unique
  name              String
  description       String?
  price             Decimal           @db.Decimal(10, 2)
  unit              ProductUnit       @default(PIECE)
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  category_id       String            @db.Uuid
  category          Category          @relation(fields: [category_id], references: [id])
  inventories       Inventory[]
  transfer_items    TransferItem[]
  transaction_items TransactionItem[]
  supplier_products SupplierProduct[]
  reception_items   ReceptionItem[]
  stock_movements      StockMovement[]
  report_lines         InventoryReportLine[]
  packaging_formats    PackagingFormat[]
  inventory_breakdowns InventoryBreakdown[]

  @@map("products")
}


// Packaging formats — product-level packaging definitions
// Examples: Unit ×1, Pack ×6, Carton ×24, Pallet ×240
// Defined at catalog level; per-store availability managed in InventoryBreakdown.
model PackagingFormat {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String               @db.Uuid
  label             String               // "Unité", "Pack ×6", "Carton ×24"
  units_per_package Int                  // Nombre d'unités de base par colis (≥ 1)
  is_base_unit      Boolean              @default(false) // Un seul par produit — unité de référence
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  product           Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  stock_movements         StockMovement[]
  inventory_breakdowns    InventoryBreakdown[]
  purchase_order_items    PurchaseOrderItem[]
  reception_items         ReceptionItem[]
  report_line_breakdowns  InventoryReportLineBreakdown[]
  transfer_items          TransferItem[]
  transaction_items       TransactionItem[]
  supplier_products       SupplierProduct[]

  @@unique([product_id, label])
  @@map("packaging_formats")
}


// Inventory breakdown — stock allocated by packaging format per store
// Optional detail to Inventory.stock_physical. Updated only when a movement
// specifies packaging_format_id. stock_physical remains the single source of truth.
model InventoryBreakdown {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id            String          @db.Uuid
  product_id          String          @db.Uuid
  packaging_format_id String          @db.Uuid
  quantity            Int             @default(0)  // Nombre de colis de ce format
  store               Store           @relation(fields: [store_id], references: [id])
  product             Product         @relation(fields: [product_id], references: [id])
  packaging_format    PackagingFormat @relation(fields: [packaging_format_id], references: [id])

  @@unique([store_id, product_id, packaging_format_id])
  @@map("inventory_breakdowns")
}


model Inventory {
  store_id       String  @db.Uuid
  product_id     String  @db.Uuid
  stock_physical Int     @default(0)
  stock_reserved Int     @default(0)
  stock_min      Int     @default(0)     // Seuil d'alerte stock bas
  stock_reorder  Int     @default(0)     // Seuil de déclenchement de réapprovisionnement
  store          Store   @relation(fields: [store_id], references: [id])
  product        Product @relation(fields: [product_id], references: [id])

  @@id([store_id, product_id])
  @@map("inventory")
}


// ---------------------------------------------------------------------------
// INTER-STORE TRANSFERS                                                    
// ---------------------------------------------------------------------------

enum TransferStatus {
  PENDING
  DONE
  CANCEL
}


model Transfer {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_store_id String         @db.Uuid
  to_store_id   String         @db.Uuid
  status        TransferStatus @default(PENDING)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  from_store    Store          @relation("TransfersFrom", fields: [from_store_id], references: [id])
  to_store      Store          @relation("TransfersTo", fields: [to_store_id], references: [id])
  items         TransferItem[]

  @@map("transfers")
}


model TransferItem {
  transfer_id         String          @db.Uuid
  product_id          String          @db.Uuid
  qty                 Int
  packaging_format_id String?         @db.Uuid
  packages_count      Int?
  transfer            Transfer        @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [product_id], references: [id])
  packaging_format    PackagingFormat? @relation(fields: [packaging_format_id], references: [id])

  @@id([transfer_id, product_id])
  @@map("transfer_items")
}


// ---------------------------------------------------------------------------
// POS / CASHIER TRANSACTIONS                                               
// ---------------------------------------------------------------------------

enum TransactionType {
  SALE
  REFUND
  EXPENSE
}


enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
}


model Transaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id       String            @db.Uuid
  user_id        String            @db.Uuid
  type           TransactionType
  payment_method PaymentMethod     @default(CASH)
  total_amount   Decimal           @db.Decimal(10, 2)
  refund_of_id   String?           @db.Uuid      // Link to original sale when type = REFUND
  created_at     DateTime          @default(now())
  store          Store             @relation(fields: [store_id], references: [id])
  user           User              @relation(fields: [user_id], references: [id])
  refund_of      Transaction?      @relation("TransactionRefunds", fields: [refund_of_id], references: [id])
  refunds        Transaction[]     @relation("TransactionRefunds")
  items          TransactionItem[]

  @@map("transactions")
}


model TransactionItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id      String           @db.Uuid
  product_id          String           @db.Uuid
  qty                 Int
  price_at_sale       Decimal          @db.Decimal(10, 2)
  packaging_format_id String?          @db.Uuid
  transaction         Transaction      @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [product_id], references: [id])
  packaging_format    PackagingFormat? @relation(fields: [packaging_format_id], references: [id])

  @@map("transaction_items")
}


// ---------------------------------------------------------------------------
// STORE TYPES & STATUS                                                     
// ---------------------------------------------------------------------------

enum StoreType {
  MAGASIN
  BOUTIQUE
  ENTREPOT
}


enum StoreStatus {
  ACTIVE
  CLOSED
}


// ---------------------------------------------------------------------------
// AUDIT LOG — traces all business operations                              
// ---------------------------------------------------------------------------

enum AuditAction {
  // Authentification
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT

  // Gestion des utilisateurs
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED

  // Gestion des établissements
  STORE_CREATED
  STORE_UPDATED
  STORE_CLOSED
  STORE_REOPENED
  STORE_DELETED

  // Gestion des fournisseurs
  SUPPLIER_CREATED
  SUPPLIER_UPDATED
  SUPPLIER_DEACTIVATED
  SUPPLIER_REACTIVATED

  // Catalogue fournisseur (liaison produit-fournisseur)
  SUPPLIER_PRODUCT_CREATED
  SUPPLIER_PRODUCT_UPDATED
  SUPPLIER_PRODUCT_DELETED

  // Gestion du catalogue
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DEACTIVATED
  PRODUCT_REACTIVATED

  // Commandes fournisseurs
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_UPDATED
  PURCHASE_ORDER_SENT
  PURCHASE_ORDER_CANCELLED
  PURCHASE_ORDER_CLOSED

  // Réceptions de stock
  RECEPTION_CREATED
  RECEPTION_CONFIRMED
  RECEPTION_CANCELLED

  // Factures fournisseurs
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_PAID
  INVOICE_DISPUTED

  // Mouvements de stock
  STOCK_MOVEMENT_CREATED

  // Transferts inter-magasins
  TRANSFER_CREATED
  TRANSFER_CONFIRMED
  TRANSFER_CANCELLED

  // Transactions caisse (POS)
  TRANSACTION_CREATED
  TRANSACTION_REFUNDED

  // Rapports d'inventaire
  INVENTORY_REPORT_CREATED
  INVENTORY_REPORT_SUBMITTED
  INVENTORY_REPORT_VALIDATED
  INVENTORY_REPORT_REJECTED
  INVENTORY_REPORT_ADJUSTED
}


// ---------------------------------------------------------------------------
// SUPPLIER MANAGEMENT                                                      
// ---------------------------------------------------------------------------

enum PaymentTerms {
  IMMEDIATE
  NET30
  NET60
  NET90
}

model Supplier {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  contact_name     String?
  email            String?           @unique
  phone            String?           @db.VarChar(20)
  address          String?
  payment_terms    PaymentTerms      @default(NET30)
  is_international Boolean           @default(false)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  supplier_products SupplierProduct[]
  purchase_orders  PurchaseOrder[]

  @@map("suppliers")
}


// Supplier catalog — per-supplier purchase conditions for each product
model SupplierProduct {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id         String          @db.Uuid
  product_id          String          @db.Uuid
  supplier_ref        String?         // Référence interne du fournisseur pour ce produit
  purchase_price      Decimal         @db.Decimal(10, 2)
  packaging_format_id String          @db.Uuid  // Format de colis commandé chez ce fournisseur
  min_order_qty       Int             @default(1)
  is_preferred        Boolean         @default(false)
  is_active           Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  supplier            Supplier        @relation(fields: [supplier_id], references: [id])
  product             Product         @relation(fields: [product_id], references: [id])
  packaging_format    PackagingFormat @relation(fields: [packaging_format_id], references: [id])
  order_items         PurchaseOrderItem[]

  @@unique([supplier_id, product_id, packaging_format_id])
  @@map("supplier_products")
}


// ---------------------------------------------------------------------------
// PURCHASE ORDERS                                                          
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}


model PurchaseOrder {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference            String              @unique // Format : BC-YYYY-XXXX
  supplier_id          String              @db.Uuid
  destination_store_id String              @db.Uuid
  ordered_by_id        String              @db.Uuid
  status               PurchaseOrderStatus @default(DRAFT)
  notes                String?
  expected_at          DateTime?
  sent_at              DateTime?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplier_id], references: [id])
  destination_store    Store               @relation("PurchaseOrderDestination", fields: [destination_store_id], references: [id])
  ordered_by           User                @relation(fields: [ordered_by_id], references: [id])
  items                PurchaseOrderItem[]
  receptions           StockReception[]
  invoice              SupplierInvoice?

  @@map("purchase_orders")
}


// Atomic sequence for PO reference generation: BC-YYYY-XXXXXX
// One record per calendar year, incremented via native PostgreSQL upsert.
model PurchaseOrderSequence {
  year     Int @id
  last_seq Int @default(0)

  @@map("purchase_order_sequences")
}


model PurchaseOrderItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String           @db.Uuid
  supplier_product_id String           @db.Uuid
  ordered_qty         Int
  unit_price          Decimal          @db.Decimal(10, 2) // Denormalized at order time
  packaging_format_id String?          @db.Uuid           // Packaging format ordered (optional)
  order               PurchaseOrder    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  supplier_product    SupplierProduct  @relation(fields: [supplier_product_id], references: [id])
  packaging_format    PackagingFormat? @relation(fields: [packaging_format_id], references: [id])

  @@unique([order_id, supplier_product_id])
  @@map("purchase_order_items")
}


// ---------------------------------------------------------------------------
// STOCK RECEPTIONS                                                         
// ---------------------------------------------------------------------------

enum ReceptionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}


model StockReception {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String          @db.Uuid
  received_by_id  String          @db.Uuid
  status          ReceptionStatus @default(PENDING)
  notes           String?
  received_at     DateTime        @default(now())
  confirmed_at    DateTime?
  order           PurchaseOrder   @relation(fields: [order_id], references: [id])
  received_by     User            @relation(fields: [received_by_id], references: [id])
  items           ReceptionItem[]

  @@map("stock_receptions")
}


model ReceptionItem {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reception_id        String           @db.Uuid
  product_id          String           @db.Uuid
  received_qty        Int              // Qty received in order units
  stock_units_added   Int              // = received_qty × units_per_order (denormalized)
  packaging_format_id String?          @db.Uuid // Packaging format received (optional)
  packages_received   Int?             // = received_qty if format set (denormalized for breakdown)
  reception           StockReception   @relation(fields: [reception_id], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [product_id], references: [id])
  packaging_format    PackagingFormat? @relation(fields: [packaging_format_id], references: [id])

  @@map("reception_items")
}


// ---------------------------------------------------------------------------
// SUPPLIER INVOICES                                                        
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  DISPUTED
}


model SupplierInvoice {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String        @unique @db.Uuid
  invoice_ref String?       // Référence de la facture fournisseur
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(PENDING)
  issued_at   DateTime      @default(now())
  due_at      DateTime?
  paid_at     DateTime?
  notes       String?
  order       PurchaseOrder @relation(fields: [order_id], references: [id])

  @@map("supplier_invoices")
}


// ---------------------------------------------------------------------------
// AUDIT LOG RECORDS                                                        
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime    @default(now())
  actor_id    String?     @db.Uuid                    // Nullable for failed login attempts
  actor_name  String                                  // Denormalized at time of action
  action      AuditAction
  target_type String?                                 // Nullable for actions without target (login/logout)
  target_id   String?     @db.Uuid
  target_name String?                                 // Denormalized at time of action
  store_id    String?     @db.Uuid                    // Nullable (failed login may lack store context)
  store_name  String?                                 // Denormalized
  ip_address  String?     @db.VarChar(45)             // IPv4 (15 chars) + IPv6 (39 chars max)
  metadata    Json?       @db.JsonB                   // Contextual data: reason, changes, details

  actor       User?       @relation(fields: [actor_id], references: [id])
  store       Store?      @relation("AuditStore", fields: [store_id], references: [id])

  @@map("audit_logs")
}


// ---------------------------------------------------------------------------
// STOCK MOVEMENTS — ledger of all stock_physical changes                  
// ---------------------------------------------------------------------------

enum MovementType {
  INITIAL        // Saisie initiale du stock (premier enregistrement)
  ADJUSTMENT_IN  // Régularisation positive (retour, erreur de comptage…)
  ADJUSTMENT_OUT // Régularisation négative (casse, perte, vol…)
  RECEPTION      // Auto-created on reception confirmation
}


model StockMovement {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id            String          @db.Uuid
  product_id          String          @db.Uuid
  type                MovementType
  qty                 Int             // Always positive in base units
  reason              String?         // Free-form reason (required for ADJUSTMENT_*)
  performed_by_id     String          @db.Uuid
  packaging_format_id String?         @db.Uuid // Optional packaging; non-null when movement by format
  packages_count      Int?            // Package count (qty = packages_count × units_per_package)
  created_at          DateTime        @default(now())
  store               Store           @relation(fields: [store_id], references: [id])
  product             Product         @relation(fields: [product_id], references: [id])
  performed_by        User            @relation("MovementsPerformedBy", fields: [performed_by_id], references: [id])
  packaging_format    PackagingFormat? @relation(fields: [packaging_format_id], references: [id])

  @@map("stock_movements")
}


// ---------------------------------------------------------------------------
// INVENTORY REPORTS — weekly physical inventory per store                 
// ---------------------------------------------------------------------------

enum ReportStatus {
  DRAFT      // En cours de saisie
  SUBMITTED  // Soumis au responsable pour validation
  VALIDATED  // Approuvé
  REJECTED   // Rejected — returned for correction
}


// Atomic sequence for inventory report reference generation: INV-YYYY-XXXX
model InventoryReportSequence {
  year     Int @id
  last_seq Int @default(0)

  @@map("inventory_report_sequences")
}


model InventoryReport {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference               String               @unique // Format: INV-YYYY-XXXX (global sequence)
  store_id                String               @db.Uuid
  status                  ReportStatus         @default(DRAFT)
  period_start            DateTime
  period_end              DateTime
  notes                   String?
  rejection_reason        String?
  created_by_id           String               @db.Uuid
  submitted_at            DateTime?
  validated_at            DateTime?
  validated_by_id         String?              @db.Uuid
  adjustments_applied_at  DateTime?            // Non-null = adjustments already applied (irreversible)
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt
  store                   Store                @relation(fields: [store_id], references: [id])
  created_by              User                 @relation("ReportsCreatedBy", fields: [created_by_id], references: [id])
  validated_by            User?                @relation("ReportsValidatedBy", fields: [validated_by_id], references: [id])
  lines                   InventoryReportLine[]

  @@map("inventory_reports")
}


model InventoryReportLine {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id         String          @db.Uuid
  product_id        String          @db.Uuid
  stock_theoretical Int             // System stock at report creation time
  stock_counted     Int             @default(0) // Physically counted quantity
  variance          Int             @default(0) // stock_counted − stock_theoretical (denormalized)
  note              String?         // Reason if variance significant
  report            InventoryReport @relation(fields: [report_id], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [product_id], references: [id])
  breakdowns        InventoryReportLineBreakdown[]

  @@unique([report_id, product_id])
  @@map("inventory_report_lines")
}


// Report line breakdown by packaging format
// Auto-created on report init if InventoryBreakdown exists for (store, product).
// Updated when count data is entered (PUT /lines).
model InventoryReportLineBreakdown {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line_id              String              @db.Uuid
  packaging_format_id  String              @db.Uuid
  packages_theoretical Int                 // Snapshot of InventoryBreakdown.quantity at creation
  packages_counted     Int                 @default(0)
  packages_variance    Int                 @default(0) // packages_counted − packages_theoretical
  line                 InventoryReportLine @relation(fields: [line_id], references: [id], onDelete: Cascade)
  packaging_format     PackagingFormat     @relation(fields: [packaging_format_id], references: [id])

  @@unique([line_id, packaging_format_id])
  @@map("inventory_report_line_breakdowns")
}


// ---------------------------------------------------------------------------
// END OF SCHEMA                                                             
// ---------------------------------------------------------------------------
