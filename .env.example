# Copier ce fichier en .env à la racine pour surcharger les valeurs Docker par défaut.
# Ce fichier est lu automatiquement par docker compose.

# OBLIGATOIRE en production — générer avec : openssl rand -hex 32
JWT_SECRET=changez-moi-en-production-avec-openssl-rand-hex-32

# Environnement (development | production)
NODE_ENV=production

# Nom de la plateforme affiché dans l'interface utilisateur.
# Passé comme build ARG au frontend lors du docker compose build.
# Si absent, la valeur par défaut "Stock Manager" est utilisée.
APP_NAME=Stock Manager

# Fournisseur d'email pour le flux "mot de passe oublié" : mailpit | resend | brevo.
# resend/brevo nécessitent leurs clés API (voir backend/.env.example — secrets, à ne pas committer ici).
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Confiance du proxy inverse (nginx/traefik) : 1 = derrière un reverse proxy.
# Requis pour que le rate limiting lise correctement X-Forwarded-For.
TRUST_PROXY=1

# Autoriser la liste publique des magasins sur la page login (démo). Désactivé par défaut.
ALLOW_PUBLIC_STORE_LIST=false
